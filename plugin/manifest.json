{
  "manifestVersion": 5,
  "id": "com.dedkul.pluck",
  "name": "Pluck",
  "version": "0.2.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "pluckPanel",
      "label": { "default": "Pluck" },
      "minimumSize": { "width": 260, "height": 360 },
      "maximumSize": { "width": 900, "height": 2000 },
      "preferredDockedSize": { "width": 340, "height": 600 },
      "preferredFloatingSize": { "width": 360, "height": 620 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin",
    "network": {
      "domains": ["http://127.0.0.1:47821"]
    },
    "launchProcess": {
      "schemes": ["https"],
      "extensions": ["command"]
    }
  }
}
